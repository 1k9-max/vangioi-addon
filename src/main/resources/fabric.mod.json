{
  "schemaVersion": 1,
  "name": "Van Gioi Client (Meteor fork)",
  "id": "${mod_id}",
  "version": "${version}",
  "description": "Van Gioi modules integrated into a transparent GPL-3.0 fork of Meteor Client.",
  "authors": [
    "MineGame159",
    "squidoodly",
    "seasnail",
    "oibanoi874"
  ],
  "contact": {
    "homepage": "https://meteorclient.com",
    "issues": "https://github.com/MeteorDevelopment/meteor-client/issues",
    "sources": "https://github.com/MeteorDevelopment/meteor-client",
    "discord": "https://meteorclient.com/discord"
  },
  "license": "GPL-3.0",
  "icon": "assets/vangioi-addon-icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "meteordevelopment.meteorclient.MeteorClient"
    ],
    "meteor": [
      "com.example.vangioi.AutoCropFarmerAddon"
    ]
  },
  "mixins": [
    "meteor-client.mixins.json",
    "meteor-client-baritone.mixins.json",
    "meteor-client-indigo.mixins.json",
    "meteor-client-sodium.mixins.json",
    "meteor-client-lithium.mixins.json",
    "meteor-client-viafabricplus.mixins.json",
    "vangioi-addon.mixins.json"
  ],
  "accessWidener": "meteor-client.accesswidener",
  "depends": {
    "java": ">=21",
    "minecraft": ["${minecraft_version}"],
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "wurst": "*",
    "sodium": "<0.6.5",
    "morechathistory": "*"
  }
}
